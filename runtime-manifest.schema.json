{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sjdrc/postgres-runtime/runtime-manifest.schema.json",
  "title": "postgres-runtime manifest",
  "description": "Machine-readable metadata attached to every published postgres-runtime artifact. The consuming application pins expected values against this document instead of discovering compatibility heuristically.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "postgres_version",
    "runtime_revision",
    "runtime_version",
    "platform",
    "source",
    "runtime",
    "configure_options",
    "extensions",
    "tools"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "postgres_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "runtime_revision": {
      "type": "integer",
      "minimum": 1
    },
    "runtime_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\+runtime\\.[0-9]+$"
    },
    "platform": {
      "type": "string",
      "pattern": "^(linux|darwin)-(amd64|arm64)$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_commit", "built_at"],
      "properties": {
        "archive_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "build_commit": { "type": "string" },
        "built_at": { "type": "string" }
      }
    },
    "configure_options": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required"],
        "properties": {
          "name": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
